# ============================================================================
# Clipzy GPU Processing Worker - environment configuration
# Copy to .env (or set in the Vast.ai template / docker run --env-file).
# NEVER hardcode credentials in code; everything comes from here.
# ============================================================================

# --- OpenRouter (REQUIRED) --------------------------------------------------
# API key for GPT-6 Luna curation + Whisper transcription.
OPENROUTER_API_KEY=
# Model endpoints - DO NOT CHANGE unless intentionally migrating models.
# The engines refuse to run when these are substituted.
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-6-luna
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo

# --- YouTube ---------------------------------------------------------------
# Optional Netscape-format cookie file contents (single line, \n-escaped is
# NOT accepted - paste the raw multi-line file with \n as real newlines, or
# base64-encode and set YT_COOKIES_B64). Improves download reliability;
# without it, anonymous worker IPs may be PO-token/bot gated.
#YT_COOKIES=
YT_COOKIES_B64=

# --- Cloudflare R2 (REQUIRED for uploads) -----------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=clipzy
R2_PUBLIC_DOMAIN=
AWS_DEFAULT_REGION=auto

# --- Storage / cache / resources --------------------------------------------
CLIPZY_WORK_ROOT=/tmp/clipzy/jobs
CLIPZY_CACHE_DIR=/var/cache/clipzy
CLIPZY_FONTS_DIR=/usr/local/share/fonts/clipzy
CLIPZY_MODELS_DIR=/opt/clipzy/models

# --- GPU / encoding -----------------------------------------------------------
# NVENC is auto-detected; set false to force libx264 (CPU baseline).
CLIPZY_ALLOW_NVENC=true
# Optional LOCAL GPU transcription with faster-whisper (default: off; the
# canonical pipeline uses OpenRouter whisper-large-v3-turbo).
CLIPZY_LOCAL_WHISPER=false
CLIPZY_LOCAL_WHISPER_MODEL=large-v3-turbo
CLIPZY_LOCAL_WHISPER_DEVICE=cuda
CLIPZY_LOCAL_WHISPER_COMPUTE_TYPE=float16

# --- Worker behaviour -----------------------------------------------------------
# One heavy pipeline at a time per GPU worker (Vast sessions queue the rest).
CLIPZY_MAX_CONCURRENT_JOBS=1
# How long finished job records stay queryable via /status.
CLIPZY_JOB_KEEP_SECONDS=3600
# Push intermediate processing status.json objects to R2 (progress polling).
CLIPZY_STATUS_UPLOADS=true
# Upload work/debug artifacts to R2 on failure (replaces GH Actions artifacts).
CLIPZY_UPLOAD_DEBUG=true
# Hard per-job timeout (seconds) - original workflow limit was 90 minutes.
CLIPZY_JOB_TIMEOUT_SECONDS=5400
# Set false to run without R2 (outputs stay local; URLs empty). NOT for prod.
CLIPZY_R2_REQUIRED=true

# --- Internal pipeline server (PyWorker "model server") ------------------------
CLIPZY_PIPELINE_HOST=127.0.0.1
CLIPZY_PIPELINE_PORT=8080
CLIPZY_PIPELINE_LOG_FILE=/var/log/clipzy/pipeline.log
